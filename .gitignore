# Rust build output and local dependency caches (also in historical fixtures).
/.cargo-home/
/.rustup/

# Keep Cargo.lock: contributors must resolve the same dependency versions.

# Generated captures, videos, binaries, logs and raw benchmark/diagnostic data.
# Historical source fixtures are required by tests and comparison examples.
/evidence/**
!/evidence/**/
!/evidence/r*/baseline/Cargo.toml
!/evidence/r*/baseline/Cargo.lock
!/evidence/r*/baseline/src/**/*.rs
!/evidence/r*/baseline/src/**/*.wgsl
!/evidence/r*/baseline/examples/**/*.rs
# Keep the compact reports linked from the development documentation.
!/evidence/**/summary.md
# Apply after directory exceptions so nested build output stays excluded.
**/target/

# Python cache generated by the verification scripts.
__pycache__/
*.py[cod]

# Local agent instructions refer to the private sibling workspace.
/AGENTS.md
/.agents/
/.codex/

# Per-machine editor settings and temporary files.
/.idea/
/.vscode/
*.swp
*.swo
*~
*.tmp
*.bak
*.orig
*.rej
*.log
.DS_Store
Thumbs.db
Desktop.ini

# Local environment/secrets; an example configuration may be versioned.
.env
.env.*
!.env.example
/.cargo/credentials
/.cargo/credentials.toml
